# Backend-local environment overrides.
# The root .env still takes precedence; this file is for values that ONLY
# the backend cares about (worker counts, log level, debug flags).

# Uvicorn / FastAPI
LOG_LEVEL=info
RELOAD=true

# Optional: override the database URL computed from POSTGRES_* in the root .env
# DATABASE_URL=postgresql+asyncpg://plotline_admin:secure_dev_pass_2026@localhost:5432/plotline_db
