# Frontend-local environment overrides (Vite).
# Only variables prefixed VITE_ are exposed to client code at build time.

# Backend API base URL — must match what Uvicorn serves.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: Maplibre style URL override. Defaults to the bundled tactical
# dark style under /src/styles/ once Phase 3 lands.
# VITE_MAP_STYLE_URL=https://example.com/style.json
